{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#d8dee9",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#616e88"
  },
  "paragraph": {},
  "list": {
    "color": "#d8dee9",
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#88c0d0",
    "bold": true
  },
  "h1": {
    "prefix": "# ",
    "color": "#88c0d0",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#88c0d0",
    "bold": true
  },
  "h3": {
    "prefix": "### ",
    "color": "#88c0d0",
    "bold": true
  },
  "h4": {
    "prefix": "#### ",
    "color": "#88c0d0",
    "bold": true
  },
  "h5": {
    "prefix": "##### ",
    "color": "#88c0d0",
    "bold": true
  },
  "h6": {
    "prefix": "###### ",
    "color": "#616e88",
    "bold": true
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true,
    "color": "#bf616a"
  },
  "emph": {
    "italic": true,
    "color": "#81a1c1"
  },
  "strong": {
    "bold": true,
    "color": "#81a1c1"
  },
  "hr": {
    "color": "#4c566a",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• ",
    "color": "#81a1c1"
  },
  "enumeration": {
    "block_prefix": ". ",
    "color": "#88c0d0"
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#81a1c1",
    "underline": true
  },
  "link_text": {
    "color": "#88c0d0"
  },
  "image": {
    "color": "#81a1c1",
    "underline": true
  },
  "image_text": {
    "color": "#616e88",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#a3be8c",
    "background_color": "#292e39"
  },
  "code_block": {
    "color": "#a3be8c",
    "background_color": "#292e39",
    "margin": 2,
    "chroma": {
      "text": { "color": "#d8dee9" },
      "error": { "color": "#2e3440", "background_color": "#bf616a" },
      "comment": { "color": "#616e88", "italic": true },
      "comment_preproc": { "color": "#d08770" },
      "keyword": { "color": "#81a1c1", "bold": true },
      "keyword_reserved": { "color": "#81a1c1" },
      "keyword_namespace": { "color": "#81a1c1" },
      "keyword_type": { "color": "#8fbcbb" },
      "operator": { "color": "#81a1c1" },
      "punctuation": { "color": "#d8dee9" },
      "name": { "color": "#d8dee9" },
      "name_builtin": { "color": "#8fbcbb" },
      "name_tag": { "color": "#81a1c1" },
      "name_attribute": { "color": "#8fbcbb" },
      "name_class": { "color": "#8fbcbb", "bold": true },
      "name_constant": { "color": "#b48ead" },
      "name_decorator": { "color": "#88c0d0" },
      "name_exception": { "color": "#bf616a" },
      "name_function": { "color": "#88c0d0" },
      "name_other": {},
      "literal": {},
      "literal_number": { "color": "#b48ead" },
      "literal_date": {},
      "literal_string": { "color": "#a3be8c" },
      "literal_string_escape": { "color": "#ebcb8b" },
      "generic_deleted": { "color": "#bf616a" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "#a3be8c" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#88c0d0" },
      "background": { "background_color": "#292e39" }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
