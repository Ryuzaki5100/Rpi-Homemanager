{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#ebdbb2",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#928374"
  },
  "paragraph": {},
  "list": {
    "color": "#ebdbb2",
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#fabd2f",
    "bold": true
  },
  "h1": {
    "prefix": "# ",
    "color": "#fabd2f",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#fabd2f",
    "bold": true
  },
  "h3": {
    "prefix": "### ",
    "color": "#fabd2f",
    "bold": true
  },
  "h4": {
    "prefix": "#### ",
    "color": "#fabd2f",
    "bold": true
  },
  "h5": {
    "prefix": "##### ",
    "color": "#fabd2f",
    "bold": true
  },
  "h6": {
    "prefix": "###### ",
    "color": "#928374",
    "bold": true
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true,
    "color": "#fb4934"
  },
  "emph": {
    "italic": true,
    "color": "#fe8019"
  },
  "strong": {
    "bold": true,
    "color": "#fe8019"
  },
  "hr": {
    "color": "#665c54",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• ",
    "color": "#fe8019"
  },
  "enumeration": {
    "block_prefix": ". ",
    "color": "#83a598"
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#83a598",
    "underline": true
  },
  "link_text": {
    "color": "#8ec07c"
  },
  "image": {
    "color": "#83a598",
    "underline": true
  },
  "image_text": {
    "color": "#928374",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#b8bb26",
    "background_color": "#1d2021"
  },
  "code_block": {
    "color": "#b8bb26",
    "background_color": "#1d2021",
    "margin": 2,
    "chroma": {
      "text": { "color": "#ebdbb2" },
      "error": { "color": "#282828", "background_color": "#fb4934" },
      "comment": { "color": "#928374", "italic": true },
      "comment_preproc": { "color": "#fe8019" },
      "keyword": { "color": "#fb4934", "bold": true },
      "keyword_reserved": { "color": "#fb4934" },
      "keyword_namespace": { "color": "#fb4934" },
      "keyword_type": { "color": "#fabd2f" },
      "operator": { "color": "#fe8019" },
      "punctuation": { "color": "#ebdbb2" },
      "name": { "color": "#ebdbb2" },
      "name_builtin": { "color": "#fabd2f" },
      "name_tag": { "color": "#fb4934" },
      "name_attribute": { "color": "#fabd2f" },
      "name_class": { "color": "#fabd2f", "bold": true },
      "name_constant": { "color": "#d3869b" },
      "name_decorator": { "color": "#8ec07c" },
      "name_exception": { "color": "#fb4934" },
      "name_function": { "color": "#8ec07c" },
      "name_other": {},
      "literal": {},
      "literal_number": { "color": "#d3869b" },
      "literal_date": {},
      "literal_string": { "color": "#b8bb26" },
      "literal_string_escape": { "color": "#fe8019" },
      "generic_deleted": { "color": "#fb4934" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "#8ec07c" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#fabd2f" },
      "background": { "background_color": "#1d2021" }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
