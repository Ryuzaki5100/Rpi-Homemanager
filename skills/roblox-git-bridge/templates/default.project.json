{
  "name": "<game-slug>",
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "<Name>Boot": {
        "$path": "src/server/<Name>Boot.server.luau"
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "<Name>Config": {
        "$path": "src/shared/<Name>Config.luau"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "<Name>Client": {
          "$path": "src/client/<Name>Client.client.luau"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Size": [512, 20, 512],
          "Position": [0, -10, 0],
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Neutral": true,
          "Size": [12, 1, 12],
          "Position": [0, 0.5, 0]
        }
      }
    }
  }
}
