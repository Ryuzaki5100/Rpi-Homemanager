#!/usr/bin/env bash
set -euo pipefail

SMB_CONF="/etc/samba/smb.conf"
# Branding shown to Apple/Windows clients. Override for a non-Pi host:
#   SMB_SERVER_NAME=myserver SMB_FRUIT_MODEL=MacSamba bash init-setup-samba
SMB_SERVER_NAME="${SMB_SERVER_NAME:-RPI5}"
SMB_FRUIT_MODEL="${SMB_FRUIT_MODEL:-RPi5}"

echo "=== Samba Setup ==="

# Install a package using whichever native package manager this host has, so
# the script works on Debian/RPi OS (apt), Arch (pacman) and Fedora (dnf).
install_pkg() {
    if command -v apt-get >/dev/null 2>&1; then
        sudo apt-get install -y "$@"
    elif command -v pacman >/dev/null 2>&1; then
        sudo pacman -S --needed --noconfirm "$@"
    elif command -v dnf >/dev/null 2>&1; then
        sudo dnf install -y "$@"
    else
        echo "No supported package manager (apt/pacman/dnf). Install manually: $*" >&2
        return 1
    fi
}

if ! command -v smbd >/dev/null 2>&1; then
    echo "Installing Samba..."
    install_pkg samba
fi

read -rp "Enter Samba username [$(whoami)]: " username
username="${username:-$(whoami)}"

if ! id "$username" &>/dev/null; then
    echo "User '$username' does not exist on this system. Create the Unix user first or use an existing one."
    exit 1
fi

for attempt in 1 2 3; do
    echo "Enter SMB password for $username (attempt $attempt/3):"
    read -rsp "Password: " password
    echo
    read -rsp "Confirm password: " password_confirm
    echo
    if [[ -n "$password" && "$password" == "$password_confirm" ]]; then
        break
    fi
    if [[ $attempt -lt 3 ]]; then
        echo "Passwords do not match or are empty. Try again."
    else
        echo "Too many failed attempts."
        exit 1
    fi
done

# fruit/streams_xattr require extended-attribute (xattr) support on the
# backing filesystem. exFAT/FAT32 (common on external drives) have none, and
# running those modules there breaks Apple-client directory listing (folders
# show up empty). Detect and only enable them where they can work. A path that
# is not currently a mounted filesystem is treated as unsupported.
fs_supports_xattr() {
    local path="$1" fstype
    if command -v findmnt >/dev/null 2>&1 && [ -z "$(findmnt -n "$path" 2>/dev/null)" ]; then
        return 1
    fi
    fstype="$(stat -f -c '%T' "$path" 2>/dev/null)"
    case "$fstype" in
        ext*|btrfs|xfs|jfs|f2fs|zfs|ntfs3) return 0 ;;
        *) return 1 ;;
    esac
}

echo "Writing $SMB_CONF..."
sudo tee "$SMB_CONF" > /dev/null <<SMBCONF
[global]
workgroup = WORKGROUP
server string = $SMB_SERVER_NAME
netbios name = $SMB_SERVER_NAME
security = user
server role = standalone server
map to guest = Bad User
dns proxy = no
obey pam restrictions = yes
unix password sync = yes
passwd program = /usr/bin/passwd %u
pam password change = yes
usershare allow guests = yes
log file = /var/log/samba/log.%m
max log size = 1000
logging = file
ntlm auth = yes
raw NTLMv2 auth = yes
min protocol = SMB2
max protocol = SMB3
ea support = yes
fruit:aapl = yes
fruit:nfs_aces = no
SMBCONF

# Home share lives on the root filesystem, always xattr-capable.
sudo tee -a "$SMB_CONF" > /dev/null <<SMBCONF

[$username]
comment = $username's shared files
path = /home/$username
browseable = yes
read only = no
valid users = $username
create mask = 0644
directory mask = 0755
force user = $username
vfs objects = recycle fruit streams_xattr
fruit:metadata = netatalk
fruit:model = $SMB_FRUIT_MODEL
fruit:advertise_fullsync = true
recycle:repository = .recycle/%U
recycle:keeptree = yes
recycle:touch = yes
recycle:versions = yes
recycle:maxsize = 0
SMBCONF

emit_share() {
    local name="$1" path="$2" repo="$3" comment="$4"
    local vfs="vfs objects = recycle"
    local extra="hide dot files = yes"
    if fs_supports_xattr "$path"; then
        vfs="vfs objects = recycle fruit streams_xattr"
        extra="fruit:metadata = netatalk
fruit:model = $SMB_FRUIT_MODEL
fruit:advertise_fullsync = true"
    fi
    sudo tee -a "$SMB_CONF" > /dev/null <<EOF

[$name]
comment = $comment
path = $path
browseable = yes
read only = no
valid users = $username
create mask = 0644
directory mask = 0755
force user = $username
$vfs
$extra
recycle:repository = $repo
recycle:keeptree = yes
recycle:touch = yes
recycle:versions = yes
recycle:maxsize = 0
EOF
}

emit_share "hdd" "/mnt/hdd" ".recycle" "$username's HDD share"
emit_share "ssd" "/mnt/ssd" ".recycle" "$username's SSD share"

if ! command -v expect &>/dev/null; then
    install_pkg expect
fi

echo "Setting SMB password for $username..."
expect <<EXPSETUP 2>&1 | grep -v "^spawn\|^$\|^New SMB\|^Retype"
set timeout 10
spawn sudo smbpasswd -a $username
expect "New SMB password:"
send "$password\r"
expect "Retype new SMB password:"
send "$password\r"
expect eof
EXPSETUP

echo "Enabling and starting Samba..."
# Debian/RPi OS use smbd.service; Arch uses smb.service.
if systemctl list-unit-files smbd.service 2>/dev/null | grep -q '^smbd\.service'; then
    sudo systemctl enable --now smbd
elif systemctl list-unit-files smb.service 2>/dev/null | grep -q '^smb\.service'; then
    sudo systemctl enable --now smb
else
    echo "Warning: neither smbd.service nor smb.service found; start Samba manually." >&2
fi

ipaddr=$(hostname -I | awk '{print $1}')
echo "=== Samba setup complete! ==="
echo "Connect from iPad via: smb://$ipaddr/$username"
echo "Also available: smb://$ipaddr/hdd and smb://$ipaddr/ssd"
echo "Restore deleted files with: make immich-hdd-undo / immich-ssd-undo"
